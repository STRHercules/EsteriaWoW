[worldserver]

########################################
# WORGOBLIN MODULE CONFIGURATION
########################################
#
#    Announce.enable (bool)
#        Description: Announce to players on login that this server runs the Worgoblin and High Elf modules.
#        Default:     1

Announce.enable = 1

#
#    Worgoblin.RunningWild.FreeApprentice (bool)
#        Description: If enabled, Worgen auto-learn Apprentice Riding (and the slower Running Wild form) at level 20.
#                     If disabled, Worgen must train Apprentice Riding normally, but Running Wild will still sync
#                     to whatever riding skill they buy.
#        Default:     1

Worgoblin.RunningWild.FreeApprentice = 1

#
#    Worgoblin.RunningWild.FreeJourneyman (bool)
#        Description: If enabled, Worgen auto-learn Journeyman Riding (and the faster Running Wild form) at level 40,
#                     in addition to whatever FreeApprentice does. If disabled, Worgen must train Journeyman normally.
#                     Does not affect Death Knights, who always get the fast Running Wild form for free.
#        Default:     1

Worgoblin.RunningWild.FreeJourneyman = 1