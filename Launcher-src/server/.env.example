# Copy this file to server/.env and set SOURCE_DIR to your local WoW client directory.
# This is the root of the Esteria WotLK 3.3.5a (build 12340) client tree.
# Keep the complete validated client outside Git.
SOURCE_DIR=C:\Esteria\CDN\client\live
LAUNCHER_UPDATES_DIR=C:\Esteria\CDN\launcher-updates

# optional: path to a JSON file overriding the bundled addon sources list.
# ADDONS_SOURCES_PATH=/path/to/addons-sources.json
