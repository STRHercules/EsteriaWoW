                <Scripts>
                    <OnClick>
                        Transmog_Try(0, this:GetParent():GetName(), 'newReset');
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnMouseDown>
                if (arg1 == "RightButton") then
                Transmog_Try(0, this:GetName(), 'newReset');
                else
                selectTransmogSlot(this:GetID(), this:GetName());
                end
            </OnMouseDown>
        </Scripts>
    </Button>

    <!-- Was referenced (MainHandSlot's "$parentSmall" child) but never defined
         in the original CMaNGOS source (both the 1.12 and 2.4.3 addon trees):
         the WotLK 3.3.5 client enforces inherited-template resolution more
         strictly than the client this addon originally shipped for, so the
         missing template now fails to load instead of silently degrading.
         No Lua code drives this button's own sub-elements today, so a plain
         smaller variant of TransmogPlayerSlot is sufficient. -->
    <Button name="TransmogPlayerSlotSmall" virtual="true" inherits="TransmogPlayerSlot">
